--- !u!114 &543715395
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 543715392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "Ellie: Oh, hi, Charlie! I can\u2019t believe someone took the flour\u2026 I
    hope you can figure out who it was."
  - 'Charlie: What do you know of the flour going missing?'
  - "Ellie: Well I had already left for the day, so not much since I didn\u2019t
    stay late."
  - 'Charlie: Do you know the locker out back?'
  - "Ellie: Yeah but I wasn\u2019t near the locker at all that day. I was cleaning
    up by the ovens."
  - "Charlie: Do you think someone from inside the bakery could\u2019ve taken the
    flour?"
  - "Ellie: I wouldn\u2019t know\u2026 but I\u2019ve seen Larry acting a bit strange
    lately. He\u2019s always talking about opening his own bakery one day"
  - 'Charlie: Thanks Ellie.'
  enableDialog: 0
  interrogateMessage: Yes, sure.
  accuseMessage: Not now.
  interrogateActions:
  - {fileID: 0}
  - {fileID: 543715394}
  - {fileID: 543715393}
  accuseActions:
  - {fileID: 0}
  - {fileID: 543715394}
