  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - 'Mr. Gardin: Hi Charlie! How''s it going?'
  - 'Charlie: Hi there, I''m fine thanks. How about you?'
  - 'Mr. Gardin: I''m good. Have you heard about the robbery in the bakery?'
  - 'Charlie: I haven''t. What''s happened?'
  - 'Mr. Gardin: I think the special flour was stolen last night.'
  - 'Mr. Gardin: Maybe you should go talk to the Baker?'
  enableDialog: 1
  interrogateMessage: Yes, sure.
  accuseMessage: Not now.
