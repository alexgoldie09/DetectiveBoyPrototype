  m_Script: {fileID: 11500000, guid: fc176ab8c2285445cb5ad9c8e081ed72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questId: 2
  questTitle: Tale of the Missing Flour
  questSteps:
  - stepId: 1
    description: You got a tip on the bakery. Check in with the baker.
  - stepId: 2
    description: You know there are two employees at the bakery. Ask around for more
      info.
  - stepId: 3
    description: Spoken to one of them, maybe should speak to the other.
  - stepId: 4
    description: Investigate the locker out back.
  - stepId: 5
    description: 'You need an access code. Hint: Examine some objects.'
  - stepId: 6
    description: Unlocked locker. Something dropped out...
  - stepId: 7
    description: Appears to be a clue, you should take it.
  - stepId: 8
    description: Investigate further. Maybe the townfolk know something.
  - stepId: 9
    description: Accuse the culprit.
  - stepId: 10
    description: Take flour to baker.
  receiveQuest: 1
  questCanvas: {fileID: 8175114582981526638}
  stepIds: 
