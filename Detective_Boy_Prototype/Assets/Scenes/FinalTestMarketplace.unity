--- !u!114 &1723575815
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788114739688511}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "Larry: Hey, Charlie, you\u2019re looking for that missing flour, huh? What a
    mess this has all turned into."
  - 'Charlie: Do you know anything about the missing flour?'
  - "Larry: Me? No way. I\u2019ve been working here for years! I wouldn\u2019t do
    anything to hurt the bakery."
  - 'Charlie: Did you see anyone near the locker?'
  - 'Larry: Now that you mention it, I saw Ellie near the locker. You know, the new
    girl.'
  - 'Charlie: Do you have access to the storage room?'
  - 'Larry: Yeah, of course. All the workers have keys, but only the baker and I
    are allowed there at night. No one else touches the flour.'
  - 'Charlie: Thanks Larry.'
  enableDialog: 0
  interrogateMessage: Yes, sure.
  accuseMessage: Not now.
  interrogateActions:
  - {fileID: 0}
  - {fileID: 1723575814}
  - {fileID: 1723575813}
  accuseActions:
  - {fileID: 0}
  - {fileID: 1723575814}
