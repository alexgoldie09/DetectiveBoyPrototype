--- !u!114 &1354899419
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788114435032555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - 'Larry: Charlie, back already? Did you figure out who took the flour?'
  - 'Charlie: I know it was you, Larry. You opened the locker with your key.'
  - "Larry: What? That\u2019s ridiculous! Why would I take the flour?"
  enableDialog: 1
  interrogateMessage: Show log.
  accuseMessage: Not enough evidence.
  interrogateActions:
  - {fileID: 6961699429974670960}
  accuseActions:
  - {fileID: 1354899421}
  - {fileID: 1354899418}
--- !u!114 &1354899421
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788114435032555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - 'Larry: Well come back when you get some real proof. Go do your job.'
  enableDialog: 0
  interrogateMessage: 
  accuseMessage: 
  interrogateActions: []
  accuseActions: []
--- !u!114 &1354899422
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788114435032555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "Charlie: I found the entry records display your name from last night. You wanted
    to use the flour to start your own bakery, didn\u2019t you?"
  - 'Larry: Oh I forgot that I had to do a quick inventory check. I still don''t
    see how that means I did it.'
  enableDialog: 1
  interrogateMessage: Show more evidence.
  accuseMessage: Not enough evidence.
  interrogateActions:
  - {fileID: 6961699429974670959}
  accuseActions:
  - {fileID: 1354899421}
  - {fileID: 1354899418}
--- !u!114 &1354899426
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788114435032555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - 'Charlie: I also found this CCTV footage from the Butcher, it looks like you.'
  - "Larry: (grumbles) Okay, okay, I admit it. I took the flour, but I didn\u2019t
    mean for things to get so messy. I can\u2019t believe it\u2026 You figured it
    out, didn\u2019t you?"
  - "Charlie: I did. You wanted to get ahead by stealing from the baker, but that
    wasn\u2019t right, Larry."
  enableDialog: 0
  interrogateMessage: 
  accuseMessage: 
  interrogateActions: []
  accuseActions: []
