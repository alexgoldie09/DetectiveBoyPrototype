--- !u!114 &234174253
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788113309592857}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - 'Baker: Oh no, oh no, this is terrible!'
  - "Baker: Charlie, my special flour\u2014it\u2019s gone! I can't bake my famous
    bread without it!"
  - 'Charlie: Did you leave the bakery unlocked?'
  - "Baker: No, I always lock up after closing! I\u2019m sure of it. But someone
    must\u2019ve found a way in."
  - 'Charlie: Has anyone been acting strange lately?'
  - "Baker: Not that I\u2019ve noticed."
  - 'Charlie: Where was the flour kept?'
  - 'Baker: In the special locker, behind the bakery. I am so confused and don''t
    know what to do now!'
  - 'Charlie: Don''t worry! I''m on it.'
  enableDialog: 0
  interrogateMessage: Yes, sure.
  accuseMessage: Not now.
  interrogateActions:
  - {fileID: 0}
  - {fileID: 234174252}
  - {fileID: 234174251}
  accuseActions:
  - {fileID: 0}
  - {fileID: 234174252}
