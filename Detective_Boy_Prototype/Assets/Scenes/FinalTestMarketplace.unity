  m_EditorClassIdentifier: 
  messages:
  - 'Butcher: Hey there Charlie, how are you?'
  - 'Charlie: I''m good! Can I ask have you heard about the bakery theft?'
  - 'Butcher: Yes, it''s tragic! I really love their bread.'
  - 'Charlie: Have you seen anything off lately with the bakery or the staff members?'
  - 'Butcher: Can''t say that I have, no.'
  - 'Charlie: Okay thank you.'
