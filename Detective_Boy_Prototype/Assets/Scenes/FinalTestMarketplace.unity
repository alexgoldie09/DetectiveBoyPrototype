MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2855788114908092470}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389726a6524564b4f879806ef5aa6a8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - 'Mr. Gardin: Hi Charlie! How''s it going?'
  - 'Charlie: Hi there, I''m fine thanks. How about you?'
  - 'Mr. Gardin: I''m good. Have you heard about the robbery in the bakery?'
  - 'Charlie: I haven''t. What''s happened?'
  - 'Mr. Gardin: I think the special flour was stolen last night.'
  - 'Mr. Gardin: Maybe you should go talk to the Baker?'
  enableDialog: 1
  interrogateMessage: Yes, sure.
  accuseMessage: Not now.
  interrogateActions:
  - {fileID: 1821229582}
  - {fileID: 1821229583}
  - {fileID: 1821229580}
  - {fileID: 1821229591}
  accuseActions:
  - {fileID: 1821229581}
  - {fileID: 1821229583}
